     "output_type": "stream",
     "text": [
      "Seuil inferieur (Tukey) est : 47.0\n",
      "----------------------------------------\n",
      "Seuil superieur (Tukey) est : 75.0\n"
     ]
    }
   ],
   "source": [
    "seuil_inf_tukey = Q1 - 3.0 * iqr\n",
    "print(\"Seuil inferieur (Tukey) est :\", (seuil_inf_tukey))\n",
    "print(\"----------------------------------------\")\n",
    "\n",
    "seuil_sup_tukey = Q3 + 3.0 * iqr\n",
    "print(\"Seuil superieur (Tukey) est :\", (seuil_sup_tukey))\n"
   ]
  },
